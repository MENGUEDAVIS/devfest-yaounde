# DevFest Yaoundé — environment
#
# Copy to .env.local and fill in. NEVER commit a filled-in copy:
# .gitignore already covers .env*, and the security checklist depends on it.

# ---------------------------------------------------------------- app ------

# Public origin, no trailing slash. Used to build the PawaPay returnUrl, so it
# must be the real HTTPS origin in production — not localhost.
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------ supabase -----

# Project URL and anon key: safe to expose, RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."

# Service role key: BYPASSES ROW LEVEL SECURITY.
# Server-only. Never prefix it with NEXT_PUBLIC_, never import it into a
# client component, never paste it into a browser console.
SUPABASE_SERVICE_ROLE_KEY="ey..."

# ------------------------------------------------------------- pawapay -----

# "sandbox" or "production". The token is environment-specific: a sandbox
# token against the production URL fails with AUTHENTICATION_ERROR.
PAWAPAY_ENV="sandbox"

# The token, from ONE of these two. See docs/decisions/0017.
#
#  (a) the literal value — local dev, or a deployment without AWS:
PAWAPAY_API_TOKEN=""
#
#  (b) the NAME of a secret in Supabase Vault — RECOMMENDED in production.
#      The deployment holds only this name. Read through get_vault_secret(),
#      which is granted to service_role alone. No new credential: it uses the
#      Supabase key the app already has. See docs/decisions/0018.
PAWAPAY_TOKEN_VAULT_KEY=""
#
#  (c) the NAME of an AWS SSM SecureString — only to share one credential
#      with the SCD shop Lambda. Puts a second cloud on the payment path,
#      so prefer (b) unless that sharing is what you want. See ADR 0017.
PAWAPAY_TOKEN_PARAM=""
#      Requires AWS credentials. On Vercel that means OIDC federation, NOT a
#      static access key: create an IAM role trusting oidc.vercel.com with
#      ssm:GetParameter on that one parameter, and set its ARN here.
AWS_ROLE_ARN=""
AWS_REGION="us-east-1"

# --- Callback hardening -----------------------------------------------------
# Everything below is OPTIONAL and starts in monitor mode: checks run and are
# logged, but only reject once their enforcement flag is on. Deploy, read the
# logs until real callbacks report pass, then enforce.

# Comma-separated PawaPay callback source IPs. Unset = check skipped.
PAWAPAY_CALLBACK_IPS=""

# PawaPay's callback signing public key, PEM. Escaped newlines (\n) are
# accepted, because the Vercel env editor collapses real ones.
PAWAPAY_CALLBACK_PUBLIC_KEY=""

# Behind a relay only (an API Gateway forwarding callbacks to this app).
# PawaPay signs the address IT was given, so the signature base must be
# rebuilt with that address rather than ours — otherwise the check can never
# pass. Leave both empty when PawaPay calls this app directly.
#   PAWAPAY_SIGNATURE_AUTHORITY="abc123.execute-api.us-east-1.amazonaws.com"
#   PAWAPAY_SIGNATURE_PATH="/prod/api/webhooks/pawapay/deposits"
PAWAPAY_SIGNATURE_AUTHORITY=""
PAWAPAY_SIGNATURE_PATH=""

# Enforcement switches. Defaults: IP enforced when PAWAPAY_ENV=production,
# signature and digest enforced when a public key is pinned.
# Behind a relay, PAWAPAY_CALLBACK_IPS must list the RELAY's egress IPs, not
# PawaPay's.
PAWAPAY_ENFORCE_IP=""
PAWAPAY_ENFORCE_SIGNATURE=""
PAWAPAY_ENFORCE_DIGEST=""

# -------------------------------------------------------------- tickets ----

# HMAC key for badge/QR codes. At least 32 characters, random, and STABLE:
# rotating it invalidates every code already issued.
#   openssl rand -base64 48
BADGE_CODE_SECRET=""

# --------------------------------------------------------------- e-mails ---

# Receipts. Leave RESEND_API_KEY empty and nothing is sent — the payment still
# completes and the send is logged as skipped. No other provider is wired in;
# swapping one means editing src/lib/email/send.ts only.
RESEND_API_KEY=""
EMAIL_FROM="DevFest Yaounde <tickets@your-domain>"

# ----------------------------------------------------------------- cron ----

# Shared secret for /api/cron/cleanup, which expires abandoned checkouts so
# they stop holding tier capacity. Vercel Cron sends it as a Bearer token.
# UNSET MEANS THE ROUTE REFUSES EVERY CALL — set it in production.
#   openssl rand -base64 32
CRON_SECRET=""

# ---------------------------------------------------- community wall (G20) --

# The DP community wall. UNSET = off, and off is the safe default: the screen
# renders no wall control and every /api/dp/gallery route answers 404.
#
# Turn it on ONLY once all three exist:
#   1. someone who WATCHES the wall — cards publish without review (ADR 0027),
#      so a problem is found by whoever notices it, not by a reviewer,
#   2. a way to honour a takedown from someone who lost their token,
#   3. a retention rule — SETTLED: 200 days, purged by the cron.
#
# It publishes photographs of faces. Default is auto-approval (ADR 0027);
# set DP_GALLERY_REVIEW=1 to put the queue back.
NEXT_PUBLIC_DP_GALLERY=""

# How long a card stays up, in days. Defaults to 200. The cron deletes the
# image first and the row second — an object outliving its row is a face
# still being served.
DP_GALLERY_RETENTION_DAYS=""

# Put the review queue back: cards wait for an organiser instead of publishing
# on arrival. Unset = published immediately, which is the decision in ADR 0027.
DP_GALLERY_REVIEW=""
